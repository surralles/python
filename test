local checkpoint = script.Parent
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local checkpointData = Instance.new("Folder")
checkpointData.Name = "CheckpointData"
checkpointData.Parent = ServerStorage

print("SISTEMA DE CHECKPOINT INICIADO")


-- GUARDAR CHECKPOINT
checkpoint.Touched:Connect(function(hit)

	local character = hit.Parent
	local humanoid = character:FindFirstChild("Humanoid")

	if humanoid then

		local player = Players:GetPlayerFromCharacter(character)

		if player then

			print("CHECKPOINT TOCADO POR:", player.Name)

			local savedCheckpoint =
				checkpointData:FindFirstChild(tostring(player.UserId))

			if not savedCheckpoint then

				savedCheckpoint = Instance.new("ObjectValue")
				savedCheckpoint.Name = tostring(player.UserId)
				savedCheckpoint.Parent = checkpointData

			end

			savedCheckpoint.Value = checkpoint

			print("CHECKPOINT GUARDADO:", checkpoint.Name)

		end
	end
end)


