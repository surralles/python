
--Este localscript va en StarterCharacterScripts
local Character = script.Parent
local Humanoid = Character:WaitForChild("Humanoid")
local Animator = Humanoid:WaitForChild("Animator")

-- Crea un objeto Animation en el script y establece su ID
local WalkAnimation = Instance.new("Animation")
WalkAnimation.AnimationId = "rbxassetid://99884378496761"--Cambia este id por el de tu animación de caminar del personaje
WalkAnimation.Parent = script

-- Carga la animación en el Animator
local WalkTrack = Animator:LoadAnimation(WalkAnimation)

-- Conecta la función al evento Running del Humanoid
Humanoid.Running:Connect(function(speed)
	if speed > 3 then
		-- El personaje se está moviendo
		if not WalkTrack.IsPlaying then
			-- Asegura que la animación esté en bucle y se reproduzca
			WalkTrack.Looped = true
			WalkTrack:Play()
		end
	else
		-- El personaje está parado
		if WalkTrack.IsPlaying then
			WalkTrack:Stop()
		end
	end
end)
