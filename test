class Converter():
   def __init__(self, usd):
       self.usd = usd
 
   def rub_to_usd(self, rub_value):
       usd_value = rub_value/self.usd
       print(round(usd_value, 2))
 
   def usd_to_rub(self, usd_value):
       rub_value = usd_value*self.usd
       print(round(rub_value, 2))
 
a = int(input('Introduzca el tipo de cambio USD'))
b = int(input('Introduzca la suma a intercambiar'))
conv = Converter(a)
option = int(input('1 - dólares a rublos / 2 - rublos a dólares'))
if option == 1:
   conv.usd_to_rub(b)
else:
   conv.rub_to_usd(b)
