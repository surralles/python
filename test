local tool = script.Parent
local player = game.Players.LocalPlayer
local camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
--HUDrecarga
local PlayerGui = player:WaitForChild("PlayerGui")
local weaponHUD = player.PlayerGui:WaitForChild("WeaponHUD")
local ammoLabel = weaponHUD:WaitForChild("AmmoLabel")


--Sonido1
local fireSound


-- CONFIG
local HIP_OFFSET = CFrame.new(0.8, -0.6, -1.2)
local AIM_LERP = 0.15

-- ESTADO
local viewmodel
local renderConn
local isAiming = false
local aimCF = CFrame.new()

local weaponModule = require(game.ReplicatedStorage.Modules[tool.Name])
local canShoot = true
local isReloading = false
local ammo = weaponModule.maxAmmo
--Recarga
local reserveAmmo = weaponModule.reserveAmmo or weaponModule.maxAmmo * 3

local function updateAmmoUI()
	ammoLabel.Text = ammo .. " / " .. reserveAmmo
end

-- REMOTE EVENT PARA DISPARO
local shootRemote = game.ReplicatedStorage:WaitForChild("Events"):WaitForChild("Shoot")

-- FUNCION PARA DISPARAR
local function Shoot()
	if not canShoot or isReloading then return end
	if ammo <= 0 then
		-- aquí luego pondremos "click vacío"
		return
	end
	canShoot = false
	ammo -= 1
	
	updateAmmoUI()
	
	-- Sonido2
	if fireSound then
		fireSound:Play()
	end
	

	-- ORIGEN Y DIRECCION DEL RAYCAST
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * weaponModule.range

	-- SPREAD
	local spread = Vector3.new(
		math.random(-100,100)/100 * weaponModule.spread,
		math.random(-100,100)/100 * weaponModule.spread,
		0
	)
	direction = (direction + spread).Unit * weaponModule.range

	-- LLAMADA AL SERVIDOR
	shootRemote:FireServer(origin, direction, weaponModule.damage)

	-- CONTROL FIRE RATE
	task.delay(weaponModule.fireRate, function()
		canShoot = true
	end)
end
--RELOAD
local function Reload()
	if isReloading then return end
	if ammo >= weaponModule.maxAmmo then return end
	if reserveAmmo <= 0 then return end

	isReloading = true
	canShoot = false

	-- (opcional) sonido de recarga
	--if reloadSound then reloadSound:Play() end

	task.delay(weaponModule.reloadTime, function()
		local needed = weaponModule.maxAmmo - ammo
		local taken = math.min(needed, reserveAmmo)

		ammo += taken
		reserveAmmo -= taken

		updateAmmoUI()

		isReloading = false
		canShoot = true
	end)
end


-- INPUT CLICK IZQUIERDO
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		Shoot()
	end
end)

-- VISIBILIDAD DEL PERSONAJE
local function setCharacterVisible(character, visible)
	for _, obj in pairs(character:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Decal") then
			obj.LocalTransparencyModifier = visible and 0 or 1
		end
	end
end

-- INPUT APUNTAR (ADS)
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAiming = true
	end
	
	if input.KeyCode == Enum.KeyCode.R then
		Reload()
	end
	
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAiming = false
	end
end)

-- EQUIPAR TOOL
tool.Equipped:Connect(function()
	local character = player.Character or player.CharacterAdded:Wait()
	camera.FieldOfView = 70

	setCharacterVisible(character, false)
	weaponHUD.Enabled = true

	local vmTemplate = game.ReplicatedStorage.Viewmodels:FindFirstChild(tool.Name)
	if not vmTemplate then
		warn("No hay ViewModel para", tool.Name)
		return
	end

	viewmodel = vmTemplate:Clone()
	viewmodel.Parent = camera

	aimCF = CFrame.new()
	isAiming = false
	
	ammo = weaponModule.maxAmmo
	reserveAmmo = weaponModule.reserveAmmo or weaponModule.maxAmmo * 3
	updateAmmoUI()
	
	
	renderConn = RunService.RenderStepped:Connect(function()
		if not viewmodel then return end

		-- CALCULAR AIM OFFSET
		if isAiming and viewmodel:FindFirstChild("AimPart") and viewmodel.PrimaryPart then
			local offset = viewmodel.AimPart.CFrame:ToObjectSpace(viewmodel.PrimaryPart.CFrame)
			aimCF = aimCF:Lerp(offset, AIM_LERP)
		else
			aimCF = aimCF:Lerp(CFrame.new(), AIM_LERP)
		end

		-- POSICIONAR VIEWMODEL
		viewmodel:PivotTo(camera.CFrame * HIP_OFFSET * aimCF)

		-- MANTENER CUERPO INVISIBLE
		if player.Character then
			setCharacterVisible(player.Character, false)
		end
	end)
	
	--Sonido3
	fireSound = viewmodel:FindFirstChild("FireSound") 
		or tool:FindFirstChild("FireSound")

	
end)

-- DESEQUIPAR TOOL
tool.Unequipped:Connect(function()
	player.CameraMode = Enum.CameraMode.Classic
	weaponHUD.Enabled = false

	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end

	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end

	if player.Character then
		setCharacterVisible(player.Character, true)
	end
end)
