# arrangement of widgets "on top of each other"
from kivy.app import App
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.boxlayout import BoxLayout

class MyApp(App):
   def build(self):
      txt = Label(text='This is a label')
      btn = Button(text='This is a button')
      btn.add_widget(Button(text='This is a button too')) # the new button is a descendant of the first button
      layout = BoxLayout()
      layout.add_widget(txt)
      layout.add_widget(btn) # this command makes two buttons visible at once (try removing)
      return layout

MyApp().run()
# the second button is not visually on the first!
# the layout of their children is controlled only by layout widgets (layout)
# other widgets (for example, a button) do not affect the location and size of their descendants

