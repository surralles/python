amount_five = 0
amount_four = 0
amount_three = 0
mark = int(input('Ingresar puntaje (0 - detener ingreso):'))
while mark != 0:
  if mark == 5:
     amount_five += 1
  if mark == 4:
     amount_four += 1
  if mark == 3:
     amount_three += 1
  marks.append(mark)
  mark = int(input('Ingresar puntaje (0 - detener ingreso):'))
