local block_size = 20
local map_limit = 200

local mapFolder = game.Workspace.Map
local startPos = Vector3.new(-map_limit, 1, -map_limit)
local endPos = Vector3.new(map_limit, 1, map_limit)

for x = -map_limit, map_limit, block_size do
	for z = -map_limit, map_limit, block_size do

		local block = game.ServerStorage.Block:Clone()
		block.Parent = mapFolder
		block.Size = Vector3.new(block_size, 20, block_size)
		block.Position = Vector3.new(x, 9, z)

		-- Crear pasillos regulares
		if (x / block_size) % 2 == 0 or (z / block_size) % 2 == 0 then
			block:Destroy()
		end

		-- Huecos aleatorios controlados
		if math.random(1, 10) == 1 then
			block:Destroy()
		end

		-- Asegurar INICIO libre
		if Vector3.new(x, 1, z) == startPos then
			block:Destroy()
		end

		-- Asegurar SALIDA libre
		if Vector3.new(x, 1, z) == endPos then
			block:Destroy()
		end
	end
end

-- Crear bloque visual de INICIO
local startBlock = game.ServerStorage.Block:Clone()
startBlock.Size = Vector3.new(block_size, 1, block_size)
startBlock.Position = startPos
startBlock.Color = Color3.fromRGB(0, 255, 0)
startBlock.Parent = mapFolder

-- Crear bloque visual de SALIDA
local endBlock = game.ServerStorage.Block:Clone()
endBlock.Size = Vector3.new(block_size, 1, block_size)
endBlock.Position = endPos
endBlock.Color = Color3.fromRGB(255, 0, 0)
endBlock.Parent = mapFolder
