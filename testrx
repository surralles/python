function StartDialogue(player, choice)

	if (choice == quest_npc_dialog.DialogChoice1) then
      print("Dialogue 1 running")
		
	elseif (choice == quest_npc_dialog.DialogChoice1.DialogChoice2) then
		print("Dialogue 2 running")
		game.ServerStorage.Poop.Parent = game.Workspace
    print("Take the crystal")
	
  end

end

quest_npc_dialog.DialogChoiceSelected:Connect(StartDialogue)




local StartPoint = script.Parent.Caca
local EndPoint = script.Parent.Final
function TouchedFunc(touched)
	if touched.Parent:FindFirstChild("Humanoid") then
		local human = touched.Parent.HumanoidRootPart
		human.Position = EndPoint.Position +Vector3.new(0, 10, 0)
	end
end
StartPoint.Touched:Connect(TouchedFunc)




local Players = game:GetService("Players")
local function leaderboardSetup(player)
	game.Workspace.Data.Player.Value = player
	local char = game.Workspace:WaitForChild(player.Name)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player
	local gold = Instance.new("IntValue")
	gold.Name = "Coins"
	gold.Value = 0
	gold.Parent = leaderstats
	local exp = Instance.new("IntValue")
	exp.Name = "Exp"
	exp.Value = 0
	exp.Parent = leaderstats
end
Players.PlayerAdded:Connect(leaderboardSetup)


function whenLoaded(player)
	warn("Jugador", player, "Conectado al juego")
	script.Parent.Player.Value = player
	print(script.Parent.Player.Value)
end
game.Players.PlayerAdded:Connect(whenLoaded)



local StarterGui = game:GetService("StarterGui")

local function checkPlayerList()
	local ok, result = pcall(function()
		StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.PlayerList)
	end)

	if ok then
		if result then
			warn("✅ PlayerList ACTIVADO (debería verse el leaderboard)")
		else
			warn("❌ PlayerList DESACTIVADO (leaderboard oculto)")
		end
	else
		warn("⚠️ No se puede comprobar el PlayerList (CoreGui aún no listo)")
	end
end

-- Esperar un poco a que cargue la UI
task.wait(2)
checkPlayerList()


StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
warn("🔧 PlayerList forzado a ACTIVADO")


