class Student():
   def __init__(self, name, average_grade):
       self.name = name
       self.average_grade = average_grade  
       self.course = '-'
   def print_info(self):
       print('Estudiante: ', self.name)
       print('Calificación promedio: ', self.average_grade)
       print('Asistiendo curso electivo: ', self.course)
   def select_course(self):
       course = input('Ingresa el nombre del curso:')
       self.course = course
 
student = Student('Darius Steph', '4.8')
student.print_info()
student.select_course()
student.print_info()


