class Rectangle():
   def __init__(self, length, width):
       self.length = length
       self.width = width
   def print_info(self):
       print('Dado un rectángulo con una longitud de', self.length, 'y un ancho de', self.width)
   def calc_perimeter(self):
       self.perimeter = (self.length + self.width) * 2
       return self.perimeter
   def calc_area(self):
       self.area = self.length * self.width
       return self.area
 
a = int(input('Ingresar longitud:'))
b = int(input('Ingresar ancho:'))
rect = Rectangle(a, b)
rect.print_info()
print('Su perímetro:', rect.calc_perimeter())
print('Su área:', rect.calc_area())
