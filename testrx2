local tool = script.Parent
local player = game.Players.LocalPlayer
local camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- CONFIG
local HIP_OFFSET = CFrame.new(0.8, -0.6, -1.2)
local AIM_LERP = 0.15

-- ESTADO
local viewmodel
local renderConn
local isAiming = false
local aimCF = CFrame.new()

-- Visibilidad del personaje
local function setCharacterVisible(character, visible)
	for _, obj in pairs(character:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Decal") then
			obj.LocalTransparencyModifier = visible and 0 or 1
		end
	end
end

-- INPUT APUNTAR
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAiming = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAiming = false
	end
end)

-- EQUIPAR
tool.Equipped:Connect(function()
	local character = player.Character or player.CharacterAdded:Wait()
	camera.FieldOfView = 70

	setCharacterVisible(character, false)

	local vmTemplate = game.ReplicatedStorage.Viewmodels:FindFirstChild(tool.Name)
	if not vmTemplate then
		warn("No hay ViewModel para", tool.Name)
		return
	end

	viewmodel = vmTemplate:Clone()
	viewmodel.Parent = camera

	aimCF = CFrame.new()
	isAiming = false

	renderConn = RunService.RenderStepped:Connect(function()
		if not viewmodel then return end

		-- CALCULAR AIM OFFSET
		if isAiming and viewmodel:FindFirstChild("AimPart") and viewmodel.PrimaryPart then
			local offset = viewmodel.AimPart.CFrame:ToObjectSpace(viewmodel.PrimaryPart.CFrame)
			aimCF = aimCF:Lerp(offset, AIM_LERP)
		else
			aimCF = aimCF:Lerp(CFrame.new(), AIM_LERP)
		end

		-- POSICIONAR VIEWMODEL
		viewmodel:PivotTo(camera.CFrame * HIP_OFFSET * aimCF)

		-- mantener cuerpo invisible
		if player.Character then
			setCharacterVisible(player.Character, false)
		end
	end)
end)

-- DESEQUIPAR
tool.Unequipped:Connect(function()
	player.CameraMode = Enum.CameraMode.Classic

	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end

	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end

	if player.Character then
		setCharacterVisible(player.Character, true)
	end
end)
